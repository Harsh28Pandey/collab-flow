<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #000000;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 40px 15px;
            color: #f4f4f5;
        }

        .wrapper {
            max-width: 600px;
            margin: auto;
        }

        .card {
            background: #09090b;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid #27272a;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.9);
        }

        .top {
            background: linear-gradient(135deg, #083344 0%, #18181b 100%);
            padding: 40px 30px;
            border-bottom: 1px solid #27272a;
        }

        .badge {
            display: inline-block;
            background: rgba(34, 211, 238, 0.1);
            border: 1px solid rgba(34, 211, 238, 0.2);
            color: #22d3ee;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .top h1 {
            color: #ffffff;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -0.5px;
            margin-bottom: 8px;
            line-height: 1.3;
        }

        .content {
            padding: 35px 30px;
        }

        .greeting {
            font-size: 16px;
            color: #a1a1aa;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .greeting strong {
            color: #ffffff;
        }

        .bento-row {
            width: 100%;
            margin-bottom: 16px;
            text-align: left;
        }

        .bento-box {
            background: #121214;
            border: 1px solid #27272a;
            padding: 20px;
            border-radius: 16px;
        }

        .bento-half {
            width: 47%;
            display: inline-block;
            vertical-align: top;
        }

        .bento-space {
            width: 4%;
            display: inline-block;
        }

        .bento-box h3 {
            color: #71717a;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .bento-box p {
            color: #ffffff;
            font-size: 15px;
            font-weight: 500;
            line-height: 1.5;
            margin: 0;
        }

        .alert-box {
            background: rgba(251, 113, 133, 0.06);
            border: 1px solid rgba(251, 113, 133, 0.2);
            padding: 16px 20px;
            border-radius: 16px;
            margin-top: 8px;
        }

        .alert-box p {
            color: #fda4af;
            font-size: 13px;
            line-height: 1.6;
            margin: 0;
        }

        .btn-wrapper {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 10px;
        }

        .btn {
            display: inline-block;
            background: #22d3ee;
            color: #09090b !important;
            text-decoration: none;
            padding: 15px 35px;
            border-radius: 14px;
            font-size: 15px;
            font-weight: bold;
            box-shadow: 0 4px 20px rgba(34, 211, 238, 0.25);
        }

        .footer {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #27272a;
            background: #09090b;
        }

        .footer p {
            font-size: 12px;
            color: #52525b;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="card">
            <div class="top">
                <span class="badge">Security Update</span>
                <h1>Your password was changed</h1>
            </div>
            <div class="content">
                <div class="greeting">
                    Hi <strong>{{userName}}</strong>,<br>
                    This is a confirmation that your Collab Flow account password was changed successfully.
                </div>

                <div class="bento-row">
                    <div class="bento-box bento-half">
                        <h3>Account</h3>
                        <p style="color: #e4e4e7;">{{userEmail}}</p>
                    </div>
                    <div class="bento-space"></div>
                    <div class="bento-box bento-half">
                        <h3>Changed On</h3>
                        <p style="color: #67e8f9;">{{changedAt}}</p>
                    </div>
                </div>

                <div class="bento-row">
                    <div class="alert-box">
                        <p>If you didn't make this change, please reset your password immediately and contact your team
                            admin.</p>
                    </div>
                </div>

                <div class="btn-wrapper">
                    <a href="{{loginUrl}}" class="btn">Login to Collab Flow</a>
                </div>
            </div>
            <div class="footer">
                <p>&copy; 2026 Collab Flow. All Rights Reserved.</p>
            </div>
        </div>
    </div>
</body>

</html>