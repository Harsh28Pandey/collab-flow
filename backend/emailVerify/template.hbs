<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #09090b;
            /* Pure deep obsidian black */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 40px 15px;
            color: #f4f4f5;
        }

        .wrapper {
            max-width: 560px;
            margin: auto;
        }

        .card {
            background: #18181b;
            /* Solid dark card background instead of glass transparency */
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid #27272a;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
        }

        .top {
            background: #0f172a;
            /* Rich dark slate header */
            padding: 45px 30px;
            text-align: center;
            border-bottom: 1px solid #27272a;
            position: relative;
        }

        .top h1 {
            color: #ffffff;
            font-size: 30px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: -0.5px;
        }

        .top p {
            color: #a1a1aa;
            font-size: 15px;
            line-height: 1.6;
            font-family: monospace;
        }

        .content {
            padding: 40px 35px;
        }

        .content h2 {
            color: #ffffff;
            font-size: 24px;
            margin-bottom: 18px;
        }

        .content p {
            color: #a1a1aa;
            font-size: 16px;
            line-height: 1.8;
            margin-bottom: 18px;
        }

        .btn-wrapper {
            text-align: center;
            margin: 35px 0;
        }

        .btn {
            display: inline-block;
            background: #38bdf8;
            /* Vibrant clean cyan button for high visibility */
            color: #09090b !important;
            text-decoration: none;
            padding: 16px 32px;
            border-radius: 16px;
            font-size: 16px;
            font-weight: 700;
            box-shadow: 0 10px 30px rgba(56, 189, 248, 0.3);
            font-family: monospace;
        }

        .note {
            background: #27272a;
            border: 1px solid #3f3f46;
            padding: 16px;
            border-radius: 16px;
            margin-top: 10px;
        }

        .note p {
            margin: 0;
            color: #38bdf8;
            font-size: 14px;
            font-weight: 500;
            font-family: monospace;
        }

        .footer {
            text-align: center;
            padding: 22px;
            border-top: 1px solid #27272a;
            background: #09090b;
        }

        .footer p {
            font-size: 13px;
            color: #71717a;
            font-family: monospace;
        }

        @media screen and (max-width: 600px) {
            .top {
                padding: 38px 22px;
            }

            .content {
                padding: 32px 24px;
            }

            .top h1 {
                font-size: 26px;
            }

            .content h2 {
                font-size: 22px;
            }

            .btn {
                width: 100%;
                padding: 15px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="card">

            <div class="top">

                <h1>Verify Your Email</h1>

                <p>
                    Complete your account verification to continue using Collab Flow
                </p>

            </div>

            <div class="content">

                <h2>Hello 👋</h2>

                <p>
                    Thanks for signing up on <strong style="color: #ffffff;">Collab Flow</strong>.
                    Please verify your email address by clicking the button below.
                </p>

                <div class="btn-wrapper">

                    <a href="{{clientUrl}}/verify?token={{token}}" class="btn" target="_blank">

                        Verify Email

                    </a>

                </div>

                <div class="note">

                    <p>
                        This verification link may expire after some time for security reasons.
                    </p>

                </div>

            </div>

            <div class="footer">

                <p>
                    &copy; 2026 Collab Flow. All Rights Reserved.
                </p>

            </div>

        </div>

    </div>

</body>

</html>